generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuntimeConfigScope {
  SYSTEM
  INDUSTRY
  TENANT
}

model RuntimeConfigEpoch {
  id String @id @default(dbgenerated("gen_random_uuid()"))
  scope RuntimeConfigScope
  tenantId String? @unique
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  industryTemplateVersionId String? @unique
  industryTemplateVersion IndustryTemplateVersion? @relation(fields: [industryTemplateVersionId], references: [id], onDelete: Cascade)
  version BigInt @default(1)
}

// ─── Roles ──────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  TEAM_LEADER
  FIELD_EXECUTIVE
  FINANCE_OPS
  SUPPORT

  PLATFORM_SUPER_ADMIN
  PLATFORM_OPERATIONS_ADMIN
  PLATFORM_ONBOARDING
  PLATFORM_SUPPORT
  PLATFORM_BILLING
  PLATFORM_AUDITOR
}

enum DataScope {
  ALL
  ASSIGNED_CITY
  ASSIGNED_TEAM
  SELF_AND_ASSIGNED_LEADS
}

// ─── Users ──────────────────────────────────────────────────────────────────────

model User {
  privateMediaCreated MediaAsset[]
  masterLegacyReconciliations MasterLegacyReconciliation[]
  masterValuesCreated MasterValue[] @relation("MasterValueCreator")
  masterOverridesCreated MasterValueOverride[] @relation("MasterOverrideCreator")
  id                 String    @id @default(uuid())
  employeeCode       String    @unique
  fullName           String
  email              String    @unique
  mobile             String?
  passwordHash       String
  avatarUrl          String?
  role               Role
  dataScope          DataScope @default(ALL)
  teamId             String?
  team               Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managerId          String?
  manager            User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       User[]    @relation("UserManager")
  defaultTerritoryId String?
  status             String    @default("ACTIVE")
  preferredLanguage  String    @default("en")
  twoFactorEnabled   Boolean   @default(false)

  lastLoginAt            DateTime?
  lastPasswordChangeAt   DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  joinedAt               DateTime  @default(now())

  sessions                    UserSession[]
  otpChallenges               OtpChallenge[]
  auditLogs                   AuditLog[]
  modulePermissions           UserModulePermission[] @relation("UserModulePermissions")
  permissionUpdates           UserModulePermission[] @relation("UserModulePermissionUpdater")
  twoFactorRoleSettingUpdates RoleTwoFactorSetting[] @relation("RoleTwoFactorSettingUpdater")

  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  tenantMemberships        TenantMembership[]
  membershipInvitesCreated TenantMembership[]           @relation("MembershipInvitedBy")
  platformRoleAssignments  PlatformUserRoleAssignment[] @relation("UserPlatformRoleAssignments")
  platformRolesAssigned    PlatformUserRoleAssignment[] @relation("PlatformRoleAssignedBy")
  publishedPlanVersions    PlanVersion[]                @relation("PlanVersionPublishedBy")
  subscriptionChanges     SubscriptionChange[]         @relation("SubscriptionChangeActor")
  provisionedTenants       TenantProvisioning[]         @relation("TenantProvisioningActor")
  provisioningAttempts    ProvisioningAttempt[]         @relation("ProvisioningAttemptActor")
  publishedIndustryVersions IndustryTemplateVersion[] @relation("IndustryPublishedBy")
  industryAssignments TenantIndustryTemplateAssignment[] @relation("IndustryAssignedBy")
  industryAssignmentChanges TenantIndustryTemplateChange[] @relation("IndustryChangeActor")
  devicePushTokens DevicePushToken[]
  notificationRecordsCreated NotificationRecord[] @relation("NotificationCreatedBy")
  notificationRecipientLogs NotificationRecipientLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([teamId])
}

// ─── Teams ──────────────────────────────────────────────────────────────────────

model Team {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  tenantId          String?
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  members           User[]
  tenantMemberships TenantMembership[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

enum PermissionScope {
  PLATFORM
  TENANT
}

// ─── RBAC ───────────────────────────────────────────────────────────────────────

model Permission {
  id              String           @id @default(uuid())
  code            String?          @unique
  scope           PermissionScope?
  domain          String?
  resource        String?
  moduleKey       String
  action          String // view, create, update, delete
  description     String?
  isActive        Boolean          @default(true)
  registryVersion String?

  rolePermissions         RolePermission[]
  tenantRolePermissions   TenantRolePermission[]
  platformRolePermissions PlatformRolePermission[]
  createdAt               DateTime                 @default(now())

  @@unique([moduleKey, action])
  @@index([moduleKey])
  @@index([scope])
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserModulePermission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserModulePermissions", fields: [userId], references: [id], onDelete: Cascade)
  moduleKey   String
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("UserModulePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
}

model RoleTwoFactorSetting {
  id          String   @id @default(uuid())
  role        Role     @unique
  enabled     Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("RoleTwoFactorSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Sessions / Devices ─────────────────────────────────────────────────────────

model UserSession {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash     String
  platform             String?
  ip                   String?
  userAgent            String?
  location             String?
  status               String            @default("ACTIVE") // ACTIVE, REVOKED
  selectedMembershipId String?
  selectedMembership   TenantMembership? @relation(fields: [selectedMembershipId], references: [id], onDelete: SetNull)
  contextVersion       Int               @default(1)
  selectedMembershipAt DateTime?
  lastSeenAt           DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId, status])
  @@index([userId, refreshTokenHash])
  @@index([selectedMembershipId])
}

// ─── OTP Challenges ─────────────────────────────────────────────────────────────

model OtpChallenge {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeToken String    @unique
  codeHash       String
  channel        String // EMAIL, SMS
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  consumedAt     DateTime?
  requestIp      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([challengeToken])
  @@index([expiresAt])
}

// ─── Audit Logs ─────────────────────────────────────────────────────────────────

model AuditLog {
  schemaVersion Int @default(1)
  scope String @default("LEGACY")
  eventCode String?
  category String?
  outcome String?
  actorType String @default("LEGACY")
  requestId String?
  correlationId String?
  originRequestId String?
  metadata Json?
  redactionVersion Int?
  id                 String            @id @default(uuid())
  actorUserId        String?
  actorUser          User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  action             String
  entityType         String?
  entityId           String?
  beforeJson         Json?
  afterJson          Json?
  ip                 String?
  userAgent          String?
  sessionId          String?
  createdAt          DateTime          @default(now())

  @@index([actorUserId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId, createdAt, id])
  @@index([eventCode, createdAt, id])
}

model MediaAsset {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creatorUserId String
  creatorUser User @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  creatorMembershipId String
  creatorMembership TenantMembership @relation(fields: [creatorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  provider String @default("S3")
  bucket String
  objectKey String
  displayName String
  mimeType String
  expectedBytes Int
  checksumSha256 String
  etag String?
  status String @default("UPLOAD_PENDING")
  uploadExpiresAt DateTime
  completedAt DateTime?
  deletedAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime @updatedAt

  @@unique([bucket, objectKey])
  @@index([tenantId, status, createdAt])
}

model BackgroundJob {
  id String @id @default(uuid())
  type String
  schemaVersion Int @default(1)
  tenantId String?
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUserId String?
  membershipId String?
  originRequestId String?
  correlationId String
  payload Json
  idempotencyKey String
  payloadHash String
  status String @default("PENDING")
  availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  attemptCount Int @default(0)
  maxAttempts Int @default(5)
  retryUntilAttempt Int @default(5)
  workerId String?
  leaseToken String?
  leaseExpiresAt DateTime?
  lastErrorCode String?
  completedAt DateTime?
  deadAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime @updatedAt
  attempts BackgroundJobAttempt[]

  @@index([status, availableAt, id])
  @@index([tenantId, createdAt, id])
}

model BackgroundJobAttempt {
  id String @id @default(uuid())
  jobId String
  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  number Int
  leaseToken String @unique
  workerId String
  status String @default("RUNNING")
  errorCode String?
  startedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  finishedAt DateTime?

  @@unique([jobId, number])
}

// ─── Shift & Schedule Management ────────────────────────────────────────────────

model Shift {
  id                    String       @id @default(uuid())
  tenantId              String?
  tenant                Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                  String // e.g. General Shift, Morning Shift, Night Shift
  code                  String
  startTime             String // "09:00"
  endTime               String // "18:00"
  gracePeriodMinutes    Int          @default(15)
  halfDayThresholdHours Float        @default(4.5)
  breakDurationMinutes  Int          @default(60)
  isActive              Boolean      @default(true)
  userShifts            UserShift[]
  attendances           Attendance[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model UserShift {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId            String
  shift              Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([shiftId])
}

// ─── Attendance & Mobile GPS Punch Logs ───────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum PunchType {
  PUNCH_IN
  PUNCH_OUT
}

model Attendance {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime          @db.Date
  shiftId            String?
  shift              Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  status             AttendanceStatus  @default(PRESENT)
  punchInTime        DateTime?
  punchOutTime       DateTime?
  totalWorkMinutes   Int               @default(0)
  overtimeMinutes    Int               @default(0)
  lateMinutes        Int               @default(0)
  remarks            String?
  punchLogs          PunchLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, tenantMembershipId, date])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([date])
  @@index([status])
}

model PunchLog {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceId       String?
  attendance         Attendance?       @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  type               PunchType
  timestamp          DateTime          @default(now())
  latitude           Float
  longitude          Float
  locationName       String?
  photoUrl           String?
  deviceId           String?
  deviceModel        String?
  ipAddress          String?

  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([attendanceId])
  @@index([timestamp])
}

// ─── Payroll & Payslips ─────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model SalaryStructure {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary         Float
  hra                Float             @default(0)
  conveyance         Float             @default(0)
  allowances         Float             @default(0)
  pfDeduction        Float             @default(0)
  esiDeduction       Float             @default(0)
  tds                Float             @default(0)
  netSalary          Float
  currency           String            @default("INR")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, tenantMembershipId])
  @@index([tenantId])
  @@index([tenantMembershipId])
}

model PayrollPeriod {
  id          String        @id @default(uuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  month       Int // 1 - 12
  year        Int // e.g. 2025
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model Payslip {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrollPeriodId    String
  payrollPeriod      PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  baseSalary         Float
  totalAllowances    Float             @default(0)
  totalDeductions    Float             @default(0)
  netPay             Float
  presentDays        Int               @default(0)
  absentDays         Int               @default(0)
  lateDays           Int               @default(0)
  overtimeHours      Float             @default(0)
  paymentStatus      PaymentStatus     @default(PENDING)
  paymentDate        DateTime?
  transactionRef     String?
  downloadUrl        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantMembershipId, payrollPeriodId])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([payrollPeriodId])
  @@index([paymentStatus])
}

// ─── Master Data Management ───────────────────────────────────────────────────

enum MasterSource {
  SYSTEM
  INDUSTRY
  TENANT
}
enum MasterOverrideScope {
  INDUSTRY
  TENANT
}
enum MasterSystemValuePolicy {
  OVERRIDABLE_LABEL
  LOCKED_IDENTITY
}
enum MasterDefinitionStatus {
  ACTIVE
  INACTIVE
}
model MasterDefinition {
  id String @id @default(uuid())
  code String @unique
  name String
  description String
  moduleCode String?
  module PlatformModule? @relation(fields: [moduleCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  valueType String @default("LABEL")
  metadataSchema String @default("NONE")
  allowTenantCreate Boolean
  allowTenantEdit Boolean
  allowTenantDeactivate Boolean
  allowIndustryDefaults Boolean
  systemValuePolicy MasterSystemValuePolicy
  displayOrder Int
  status MasterDefinitionStatus @default(ACTIVE)
  revision Int @default(1)
  values MasterValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([moduleCode])
}
model MasterValue {
  leadSources Lead[] @relation("LeadSource")
  crmBusinessTypes Account[] @relation("AccountBusinessType")
  crmSources Account[] @relation("AccountSource")
  crmContactRoles Contact[] @relation("ContactRole")
  opportunityStages Opportunity[] @relation("OpportunityStage")
  opportunitySources Opportunity[] @relation("OpportunitySource")
  legacyReconciliation MasterLegacyReconciliation?
  id String @id @default(uuid())
  definitionId String
  definition MasterDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  source MasterSource
  tenantId String?
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  industryTemplateVersionId String?
  industryTemplateVersion IndustryTemplateVersion? @relation(fields: [industryTemplateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code String
  name String
  description String?
  displayColor String?
  sortOrder Int
  isActive Boolean @default(true)
  revision Int @default(1)
  createdByUserId String?
  createdBy User? @relation("MasterValueCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  overrides MasterValueOverride[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Partial source-specific uniqueness and scope checks are in M8 SQL.
  @@index([definitionId, source])
  @@index([tenantId, definitionId])
  @@index([industryTemplateVersionId, definitionId])
}
model MasterValueOverride {
  id String @id @default(uuid())
  inheritedMasterValueId String
  inheritedMasterValue MasterValue @relation(fields: [inheritedMasterValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scope MasterOverrideScope
  tenantId String?
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  industryTemplateVersionId String?
  industryTemplateVersion IndustryTemplateVersion? @relation(fields: [industryTemplateVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  displayName String?
  displayColor String?
  sortOrder Int?
  isHidden Boolean @default(false)
  revision Int @default(1)
  createdByUserId String?
  createdBy User? @relation("MasterOverrideCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([inheritedMasterValueId])
  @@index([tenantId])
  @@index([industryTemplateVersionId])
}

// Explicit reviewed legacy ownership; original rows remain retained and unchanged.
model MasterLegacyReconciliation {
  legacyRecordId String @id
  legacyRecord MasterRecord @relation(fields: [legacyRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  masterValueId String @unique
  masterValue MasterValue @relation(fields: [masterValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  mappingHash String
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now())
}

model MasterRecord {
  reconciliation MasterLegacyReconciliation?
  id              String   @id @default(uuid())
  category        String // designation, team, incentive_type, allowance_type, deduction_type, shift, territory, expense_category, lead_stage, lead_source
  name            String
  code            String
  description     String?
  displayColor    String? // hex code or tailwind color class
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
  @@index([category, isActive])
}

// ─── Platform Modules & Features System ───────────────────────────────────────

enum PlatformModuleCategory {
  CORE
  SALES
  FIELD_OPS
  AUTOMATION
  ENTERPRISE
}

enum PlatformModuleStatus {
  DRAFT
  ACTIVE
  BETA
  DEPRECATED
  ARCHIVED
}

enum ModuleFeatureStatus {
  ACTIVE
  BETA
  DEPRECATED
}

model PlatformModule {
  masterDefinitions MasterDefinition[]
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  description String
  category    PlatformModuleCategory @default(CORE)
  status      PlatformModuleStatus   @default(ACTIVE)

  requiredBySystem Boolean @default(false)
  displayOrder     Int     @default(0)
  internalNotes    String?

  features ModuleFeature[]

  dependencies ModuleDependency[] @relation("ModuleDependencies")
  dependents   ModuleDependency[] @relation("ModuleDependents")
  planModules  PlanModule[]
  industryRecommendations IndustryTemplateModuleRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([displayOrder])
}

model ModuleFeature {
  id                String              @id @default(uuid())
  moduleId          String
  module            PlatformModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String
  status            ModuleFeatureStatus @default(ACTIVE)
  implementationKey String              @unique
  supportsWeb       Boolean             @default(false)
  supportsMobile    Boolean             @default(false)
  supportsApi       Boolean             @default(false)
  supportsOffline   Boolean             @default(false)
  displayOrder      Int                 @default(0)
  internalNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, code])
  @@index([moduleId])
  @@index([status])
}

model ModuleDependency {
  id                String         @id @default(uuid())
  moduleId          String
  module            PlatformModule @relation("ModuleDependencies", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOnModuleId String
  dependsOnModule   PlatformModule @relation("ModuleDependents", fields: [dependsOnModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([moduleId, dependsOnModuleId])
  @@index([moduleId])
  @@index([dependsOnModuleId])
}

// ─── Phase 0.2 — Tenant & Membership Models ────────────────────────────────────

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TenantAddressType {
  REGISTERED
  BILLING
  OFFICE
}

enum TenantMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformAssignmentStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

model Tenant {
  devicePushTokens DevicePushToken[]
  notificationRecords NotificationRecord[]
  notificationTemplates NotificationTemplate[]
  crmLeads Lead[]
  leadHistories LeadHistory[]
  leadConversions LeadConversionCommand[]
  leadVisits LeadVisit[]
  leadFollowUps LeadFollowUp[]
  leadDemos LeadDemo[]
  leadCommunications LeadCommunication[]
  crmAccounts Account[]
  crmContacts Contact[]
  crmOpportunities Opportunity[]
  privateMedia MediaAsset[]
  backgroundJobs BackgroundJob[]
  runtimeConfigEpoch RuntimeConfigEpoch?
  masterValues MasterValue[]
  masterOverrides MasterValueOverride[]
  industryCode    String?
  industry        IndustryClassification? @relation(fields: [industryCode], references: [code], onDelete: Restrict)
  subscription    TenantSubscription?
  provisioning    TenantProvisioning?
  industryTemplateAssignment TenantIndustryTemplateAssignment?
  industryTemplateChanges TenantIndustryTemplateChange[]
  id              String                  @id @default(uuid())
  slug            String                  @unique
  displayName     String
  legalName       String?
  primaryDomain   String?                 @unique
  websiteUrl      String?
  status          TenantStatus            @default(DRAFT)
  companySizeCode String?
  description     String?

  activatedAt DateTime?
  suspendedAt DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?

  addresses        TenantAddress[]
  settings         TenantSettings?
  branding         TenantBranding?
  memberships      TenantMembership[]
  roles            TenantRole[]
  teams            Team[]
  shifts           Shift[]
  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payrollPeriods   PayrollPeriod[]
  payslips         Payslip[]
  auditLogs        AuditLog[]
  territories      Territory[]
  territoryMembers TerritoryMember[]
  territoryBoundaryPoints TerritoryBoundaryPoint[]
  territoryTargets TerritoryTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model TenantAddress {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          TenantAddressType @default(REGISTERED)
  label         String?
  line1         String
  line2         String?
  city          String
  stateOrRegion String?
  postalCode    String?
  countryCode   String            @default("IN")
  isPrimary     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenantSettings {
  id                      String @id @default(uuid())
  tenantId                String @unique
  tenant                  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone                String @default("Asia/Kolkata")
  currency                String @default("INR")
  locale                  String @default("en-IN")
  language                String @default("en")
  dateFormat              String @default("YYYY-MM-DD")
  weekStartDay            String @default("MONDAY")
  financialYearStartMonth Int    @default(4)
  configVersion           Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantBranding {
  id              String  @id @default(uuid())
  tenantId        String  @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortName       String?
  primaryColor    String? @default("#0D1F3D")
  secondaryColor  String?
  logoUrl         String?
  showLogoOnLogin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantMembership {
  lead0 Lead[] @relation("LeadOwner")
  lead1 Lead[] @relation("LeadAssignee")
  lead2 Lead[] @relation("LeadCreator")
  lead3 Lead[] @relation("LeadUpdater")
  lead4 Lead[] @relation("LeadConverter")
  leadHistoryEvents LeadHistory[]
  leadConversionCommands LeadConversionCommand[]
  executiveVisits LeadVisit[]
  assignedFollowUps LeadFollowUp[]
  conductedDemos LeadDemo[]
  loggedCommunications LeadCommunication[]
  ownedAccounts Account[] @relation("AccountOwner")
  createdAccounts Account[] @relation("AccountCreator")
  updatedAccounts Account[] @relation("AccountUpdater")
  ownedContacts Contact[] @relation("ContactOwner")
  createdContacts Contact[] @relation("ContactCreator")
  updatedContacts Contact[] @relation("ContactUpdater")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  assignedOpportunities Opportunity[] @relation("OpportunityAssignee")
  privateMedia MediaAsset[]
  provisioningOwnership TenantProvisioning[]
  devicePushTokens DevicePushToken[]
  managedTerritories Territory[] @relation("TerritoryManager")
  createdTerritories Territory[] @relation("TerritoryCreator")
  updatedTerritories Territory[] @relation("TerritoryUpdater")
  territoryMemberships TerritoryMember[] @relation("TerritoryMemberMembership")
  assignedTerritoryMemberships TerritoryMember[] @relation("TerritoryMemberAssigner")
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantRoleId          String?
  tenantRole            TenantRole?            @relation(fields: [tenantRoleId], references: [id], onDelete: SetNull)
  status                TenantMembershipStatus @default(ACTIVE)
  isPrimary             Boolean                @default(false)

  employeeCode String?
  designation  String?
  department   String?
  dataScope    DataScope? @default(ALL)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  managerMembershipId    String?
  managerMembership      TenantMembership?  @relation("MembershipManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  subordinateMemberships TenantMembership[] @relation("MembershipManager")

  invitedByUserId String?
  invitedByUser   User?   @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  invitedAt     DateTime?
  joinedAt      DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?

  selectedSessions UserSession[]
  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantRoleId])
  @@index([managerMembershipId])
}

model TenantRoleTemplate {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(true)
  isActive    Boolean @default(true)

  roles TenantRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantRole {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId         String?
  template           TenantRoleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  code               String
  name               String
  description        String?
  isSystem           Boolean             @default(true)
  isActive           Boolean             @default(true)
  permissionsVersion Int                 @default(1)

  memberships TenantMembership[]
  permissions TenantRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model TenantRolePermission {
  id           String     @id @default(uuid())
  tenantRoleId String
  tenantRole   TenantRole @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantRoleId, permissionId])
  @@index([tenantRoleId])
}

model PlatformRole {
  id                 String  @id @default(uuid())
  code               String  @unique
  name               String
  description        String?
  isSystem           Boolean @default(true)
  isActive           Boolean @default(true)
  permissionsVersion Int     @default(1)

  assignments PlatformUserRoleAssignment[]
  permissions PlatformRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformRolePermission {
  id             String       @id @default(uuid())
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([platformRoleId, permissionId])
  @@index([platformRoleId])
}

model PlatformUserRoleAssignment {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation("UserPlatformRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  platformRoleId   String
  platformRole     PlatformRole             @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  status           PlatformAssignmentStatus @default(ACTIVE)
  validFrom        DateTime?
  validUntil       DateTime?
  assignedByUserId String?
  assignedByUser   User?                    @relation("PlatformRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platformRoleId])
  @@index([userId, status])
  @@index([platformRoleId])
}

// ─── Phase 0.5 — Plan & PlanVersion Commercial Engine ──────────────────────────

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanVisibility {
  PUBLIC
  INTERNAL
  INVITE_ONLY
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
}

enum PricingModel {
  PER_USER
  BASE_PLUS_PER_USER
  FLAT
  CUSTOM_CONTRACT
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
}

enum ProrationPolicy {
  NONE
  IMMEDIATE
  NEXT_BILLING_CYCLE
}

enum ExpiryAccess {
  READ_ONLY
  BLOCKED
}

enum ChangeEffectiveTiming {
  IMMEDIATE
  NEXT_BILLING_CYCLE
}

enum LimitValueType {
  INTEGER
  DECIMAL
  BOOLEAN
}

model Plan {
  id                        String         @id @default(uuid())
  code                      String         @unique
  name                      String
  description               String
  internalDescription       String?
  status                    PlanStatus     @default(DRAFT)
  visibility                PlanVisibility @default(PUBLIC)
  tier                      String?
  badge                     String?
  recommendedFor            String?
  displayOrder              Int            @default(0)
  color                     String?
  currentPublishedVersionId String?
  currentPublishedVersion   PlanVersion?   @relation("CurrentPublishedPlanVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)

  versions PlanVersion[] @relation("PlanVersions")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([status])
  @@index([visibility])
  @@index([displayOrder])
}

model PlanVersion {
  subscriptions     TenantSubscription[]
  changesFrom       SubscriptionChange[] @relation("SubscriptionChangeFrom")
  changesTo         SubscriptionChange[] @relation("SubscriptionChangeTo")
  id                String               @id @default(uuid())
  planId            String
  plan              Plan                 @relation("PlanVersions", fields: [planId], references: [id], onDelete: Restrict)
  version           Int
  status            PlanVersionStatus    @default(DRAFT)
  publishedAt       DateTime?
  publishedByUserId String?
  publishedByUser   User?                @relation("PlanVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  currentPublishedForPlans Plan[] @relation("CurrentPublishedPlanVersion")

  pricing        PlanPricing[]
  limits         PlanLimit[]
  modules        PlanModule[]
  commercialRule PlanCommercialRule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, version])
  @@index([planId, status])
  @@index([status])
}

model PlanPricing {
  id                      String          @id @default(uuid())
  planVersionId           String
  planVersion             PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  model                   PricingModel    @default(PER_USER)
  billingCycle            BillingCycle
  currency                String          @default("INR")
  baseFee                 Decimal?        @db.Decimal(18, 2)
  perSeatFee              Decimal?        @db.Decimal(18, 2)
  flatFee                 Decimal?        @db.Decimal(18, 2)
  setupFee                Decimal?        @db.Decimal(18, 2)
  minimumCommitmentAmount Decimal?        @db.Decimal(18, 2)
  discountPercent         Decimal?        @db.Decimal(5, 2)
  taxMode                 TaxMode         @default(EXCLUSIVE)
  prorationPolicy         ProrationPolicy @default(NONE)

  createdAt DateTime @default(now())

  @@unique([planVersionId, billingCycle])
  @@index([planVersionId])
}

model PlanLimit {
  id            String         @id @default(uuid())
  planVersionId String
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  limitCode     String
  valueType     LimitValueType
  integerValue  Int?
  decimalValue  Decimal?       @db.Decimal(18, 2)
  booleanValue  Boolean?
  isUnlimited   Boolean        @default(false)
  unit          String?

  createdAt DateTime @default(now())

  @@unique([planVersionId, limitCode])
  @@index([planVersionId])
  @@index([limitCode])
}

model PlanModule {
  id            String         @id @default(uuid())
  planVersionId String
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  moduleId      String
  module        PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([planVersionId, moduleId])
  @@index([planVersionId])
  @@index([moduleId])
}

model PlanCommercialRule {
  id            String      @id @default(uuid())
  planVersionId String      @unique
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  schemaVersion Int         @default(1)
  rules         Json

  createdAt DateTime @default(now())

  @@index([planVersionId])
}

// Phase 0.6: classification only; never an entitlement or Industry template.
enum IndustryTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IndustryTemplateVersionStatus {
  DRAFT
  PUBLISHED
}

model IndustryTemplate {
  id String @id @default(uuid())
  code String @unique
  classification IndustryClassification @relation(fields: [code], references: [code], onDelete: Restrict)
  name String
  category String
  description String
  status IndustryTemplateStatus @default(DRAFT)
  revision Int @default(1)
  currentPublishedVersionId String? @unique
  currentPublishedVersion IndustryTemplateVersion? @relation("CurrentIndustryVersion", fields: [currentPublishedVersionId], references: [id], onDelete: Restrict)
  versions IndustryTemplateVersion[] @relation("IndustryVersions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
}

model IndustryTemplateVersion {
  runtimeConfigEpoch RuntimeConfigEpoch?
  masterValues MasterValue[]
  masterOverrides MasterValueOverride[]
  id String @id @default(uuid())
  industryTemplateId String
  industryTemplate IndustryTemplate @relation("IndustryVersions", fields: [industryTemplateId], references: [id], onDelete: Restrict)
  currentFor IndustryTemplate? @relation("CurrentIndustryVersion")
  version Int
  revision Int @default(1)
  status IndustryTemplateVersionStatus @default(DRAFT)
  schemaVersion Int @default(1)
  terminology Json
  masterDefaults Json
  sourceFixtureId String?
  sourceHash String?
  approvalReference String?
  publishedAt DateTime?
  publishedByUserId String?
  publishedBy User? @relation("IndustryPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  recommendations IndustryTemplateModuleRecommendation[]
  assignments TenantIndustryTemplateAssignment[]
  changesFrom TenantIndustryTemplateChange[] @relation("IndustryChangeFrom")
  changesTo TenantIndustryTemplateChange[] @relation("IndustryChangeTo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([industryTemplateId, version])
}

model IndustryTemplateModuleRecommendation {
  id String @id @default(uuid())
  industryTemplateVersionId String
  industryTemplateVersion IndustryTemplateVersion @relation(fields: [industryTemplateVersionId], references: [id], onDelete: Restrict)
  moduleId String
  module PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  @@unique([industryTemplateVersionId, moduleId])
  @@index([moduleId])
}

model TenantIndustryTemplateAssignment {
  id String @id @default(uuid())
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  industryTemplateVersionId String
  industryTemplateVersion IndustryTemplateVersion @relation(fields: [industryTemplateVersionId], references: [id], onDelete: Restrict)
  revision Int @default(1)
  assignedAt DateTime @default(now())
  assignedByUserId String
  assignedBy User @relation("IndustryAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([industryTemplateVersionId])
}

model TenantIndustryTemplateChange {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fromVersionId String?
  fromVersion IndustryTemplateVersion? @relation("IndustryChangeFrom", fields: [fromVersionId], references: [id], onDelete: Restrict)
  toVersionId String
  toVersion IndustryTemplateVersion @relation("IndustryChangeTo", fields: [toVersionId], references: [id], onDelete: Restrict)
  revision Int
  reason String
  actorUserId String
  actor User @relation("IndustryChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String?
  createdAt DateTime @default(now())
  @@unique([tenantId, revision])
  @@index([fromVersionId])
  @@index([toVersionId])
}

model IndustryClassification {
  template IndustryTemplate?
  code     String   @id
  name     String
  isActive Boolean  @default(true)
  tenants  Tenant[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

enum SubscriptionChangeStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

enum ProvisioningEventStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

model TenantSubscription {
  id                 String               @id @default(uuid())
  tenantId           String               @unique
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planVersionId      String
  planVersion        PlanVersion          @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  billingCycle       BillingCycle
  seatQuantity       Int
  status             SubscriptionStatus
  revision           Int                  @default(1)
  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelledAt        DateTime?
  suspendedFromStatus SubscriptionStatus?
  changes            SubscriptionChange[]
  provisioning       TenantProvisioning?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([id, tenantId])
}

model SubscriptionChange {
  id                String                   @id @default(uuid())
  subscriptionId    String
  tenantId          String
  subscription      TenantSubscription       @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  idempotencyKey    String
  payloadHash       String
  kind              String
  reason            String
  fromPlanVersionId String
  fromPlanVersion   PlanVersion              @relation("SubscriptionChangeFrom", fields: [fromPlanVersionId], references: [id], onDelete: Restrict)
  toPlanVersionId   String
  toPlanVersion     PlanVersion              @relation("SubscriptionChangeTo", fields: [toPlanVersionId], references: [id], onDelete: Restrict)
  fromStatus        SubscriptionStatus
  toStatus          SubscriptionStatus
  status            SubscriptionChangeStatus
  requestedAt       DateTime                 @default(now())
  effectiveAt       DateTime
  appliedAt         DateTime?
  actorUserId       String
  actor             User                     @relation("SubscriptionChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "SubscriptionChange_actor_fkey")
  requestId         String?
  revision          Int
  requestData       Json
  result            Json

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId, requestedAt])
  @@index([status, effectiveAt])
}

model TenantProvisioning {
  id                String              @id @default(uuid())
  idempotencyKey    String              @unique
  payloadHash       String
  tenantId          String              @unique
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId    String              @unique
  subscription      TenantSubscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ownerMembershipId String
  ownerMembership   TenantMembership    @relation(fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorUserId       String
  actor             User                @relation("TenantProvisioningActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "TenantProvisioning_actor_fkey")
  requestId         String?
  acceptedAt        DateTime?
  createdAt         DateTime            @default(now())
  events            ProvisioningEvent[]

  @@unique([subscriptionId, tenantId])
}

model ProvisioningEvent {
  id             String                  @id @default(uuid())
  provisioningId String
  provisioning   TenantProvisioning      @relation(fields: [provisioningId], references: [id], onDelete: Restrict)
  kind           String
  schemaVersion  Int                     @default(1)
  status         ProvisioningEventStatus @default(PENDING)
  attemptCount   Int                     @default(0)
  leaseToken     String?
  leaseEndsAt    DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  attempts       ProvisioningAttempt[]

  @@unique([provisioningId, kind])
  @@index([status, createdAt])
}

model ProvisioningAttempt {
  id          String                  @id @default(uuid())
  eventId     String
  event       ProvisioningEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attemptKey  String
  leaseToken  String                  @unique
  actorUserId String
  actor       User                    @relation("ProvisioningAttemptActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "ProvisioningAttempt_actor_fkey")
  status      ProvisioningEventStatus @default(PROCESSING)
  errorCode   String?
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?

  @@unique([eventId, attemptKey])
}

enum CrmRecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Account {
  currentLeads Lead[] @relation("LeadAccount")
  convertedLeads Lead[] @relation("LeadConvertedAccount")
  leadConversionCommands LeadConversionCommand[]
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name String
  businessTypeValueId String?
  businessTypeValue MasterValue? @relation("AccountBusinessType", fields: [businessTypeValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceValueId String?
  sourceValue MasterValue? @relation("AccountSource", fields: [sourceValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoryLabel String?
  status CrmRecordStatus @default(ACTIVE)
  ownerMembershipId String
  ownerMembership TenantMembership @relation("AccountOwner", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  countryCode String?
  website String?
  gstin String?
  establishedYear Int?
  description String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdByMembershipId String
  createdByMembership TenantMembership @relation("AccountCreator", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  updatedByMembershipId String
  updatedByMembership TenantMembership @relation("AccountUpdater", fields: [updatedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  contacts Contact[]
  opportunities Opportunity[]
  territoryId String?
  territory Territory? @relation(fields: [territoryId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)
  @@unique([id, tenantId])
  @@index([tenantId, deletedAt, createdAt, id])
  @@index([tenantId, ownerMembershipId, deletedAt])
  @@index([tenantId, territoryId, deletedAt])
}

model Contact {
  currentLeads Lead[] @relation("LeadContact")
  convertedLeads Lead[] @relation("LeadConvertedContact")
  leadConversionCommands LeadConversionCommand[]
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId String?
  account Account? @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  name String
  phone String?
  email String?
  roleValueId String?
  roleValue MasterValue? @relation("ContactRole", fields: [roleValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status CrmRecordStatus @default(ACTIVE)
  ownerMembershipId String?
  ownerMembership TenantMembership? @relation("ContactOwner", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  isPrimary Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdByMembershipId String
  createdByMembership TenantMembership @relation("ContactCreator", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  updatedByMembershipId String
  updatedByMembership TenantMembership @relation("ContactUpdater", fields: [updatedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  opportunities Opportunity[]
  @@unique([id, tenantId])
  @@index([tenantId, accountId, deletedAt, createdAt, id])
  @@index([tenantId, ownerMembershipId, deletedAt])
}


enum LeadLifecycle {
  OPEN
  QUALIFIED
  CONVERTED
  DISQUALIFIED
  DUPLICATE
}
enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum LeadKind {
  BUSINESS
  INDIVIDUAL
}
model Lead {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadCode String
  kind LeadKind @default(BUSINESS)
  name String
  businessName String?
  contactName String?
  phone String?
  email String?
  website String?
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  countryCode String?
  description String?
  estimatedValue Decimal? @db.Decimal(14, 2)
  expectedClosingDate DateTime?
  nextFollowUpAt DateTime?
  nextActionNote String?
  requirementNote String?
  disqualificationReason String?
  sourceValueId String?
  sourceValue MasterValue? @relation("LeadSource", fields: [sourceValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status LeadLifecycle @default(OPEN)
  priority LeadPriority @default(MEDIUM)
  ownerMembershipId String
  ownerMembership TenantMembership @relation("LeadOwner", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  assignedMembershipId String?
  assignedMembership TenantMembership? @relation("LeadAssignee", fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  accountId String?
  account Account? @relation("LeadAccount", fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  contactId String?
  contact Contact? @relation("LeadContact", fields: [contactId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  convertedAccountId String?
  convertedAccount Account? @relation("LeadConvertedAccount", fields: [convertedAccountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  convertedContactId String?
  convertedContact Contact? @relation("LeadConvertedContact", fields: [convertedContactId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  convertedAt DateTime?
  convertedByMembershipId String?
  convertedByMembership TenantMembership? @relation("LeadConverter", fields: [convertedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  createdByMembershipId String
  createdByMembership TenantMembership @relation("LeadCreator", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  updatedByMembershipId String
  updatedByMembership TenantMembership @relation("LeadUpdater", fields: [updatedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  histories LeadHistory[]
  visits LeadVisit[]
  followUps LeadFollowUp[]
  demos LeadDemo[]
  communications LeadCommunication[]
  conversion LeadConversionCommand?
  opportunity Opportunity?
  territoryId String?
  territory Territory? @relation(fields: [territoryId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)
  @@unique([id, tenantId])
  @@unique([tenantId, leadCode])
  @@index([tenantId, deletedAt, createdAt, id])
  @@index([tenantId, ownerMembershipId, deletedAt])
  @@index([tenantId, assignedMembershipId, deletedAt])
  @@index([tenantId, status, priority, deletedAt])
  @@index([tenantId, nextFollowUpAt, deletedAt])
  @@index([tenantId, accountId])
  @@index([tenantId, contactId])
  @@index([tenantId, convertedAccountId])
  @@index([tenantId, convertedContactId])
  @@index([tenantId, territoryId, deletedAt])
}
model LeadHistory {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId String
  lead Lead @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  eventType String
  message String
  note String?
  actorMembershipId String
  actorMembership TenantMembership @relation(fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  metadata Json?
  createdAt DateTime @default(now())
  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, eventType, createdAt])
}
model LeadConversionCommand {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  leadId String
  lead Lead @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  idempotencyKey String
  payloadHash String
  resultRevision Int
  accountId String?
  account Account? @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  contactId String?
  contact Contact? @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actorMembershipId String
  actorMembership TenantMembership @relation(fields: [actorMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@unique([id, tenantId])
  @@unique([leadId, tenantId])
  @@unique([tenantId, leadId, idempotencyKey])
}

// ─── Opportunity / Deal Model (Sales Pipeline) ─────────────────────────────────
model Opportunity {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dealCode              String
  title                 String
  amount                Decimal           @default(0) @db.Decimal(14, 2)
  stageValueId          String?
  stageValue            MasterValue?      @relation("OpportunityStage", fields: [stageValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stage                 String            @default("new")
  priority              LeadPriority      @default(MEDIUM)
  sourceValueId         String?
  sourceValue           MasterValue?      @relation("OpportunitySource", fields: [sourceValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  
  leadId                String?
  lead                  Lead?             @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)
  accountId             String?
  account               Account?          @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  contactId             String?
  contact               Contact?          @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)
  
  assignedMembershipId  String?
  assignedMembership    TenantMembership? @relation("OpportunityAssignee", fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  ownerMembershipId     String
  ownerMembership       TenantMembership  @relation("OpportunityOwner", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  
  expectedClosingDate   DateTime?
  closedAt              DateTime?
  lostReason            String?
  description           String?
  
  revision              Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  @@unique([id, tenantId])
  @@unique([tenantId, dealCode])
  @@unique([leadId, tenantId])
  @@index([tenantId, deletedAt, stage])
  @@index([tenantId, assignedMembershipId])
}

// ─── Push Notification Device Tokens ──────────────────────────────────────────
model DevicePushToken {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId     String?
  membership       TenantMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  token            String            @unique
  platform         String            // ANDROID, IOS, WEB
  deviceModel      String?
  appVersion       String?
  isActive         Boolean           @default(true)
  lastSeenAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  recipientLogs    NotificationRecipientLog[]

  @@index([userId, isActive])
  @@index([tenantId, isActive])
  @@index([platform])
}

// ─── Notification Broadcast / Campaign Record ─────────────────────────────────
model NotificationRecord {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  description      String
  type             String            // ANNOUNCEMENT, ALERT, REMINDER, PROMOTION, UPDATE, SYSTEM
  channels         String[]          // PUSH, IN_APP, EMAIL, WHATSAPP, SMS
  targetAudience   String            // ALL_USERS, FIELD_EXECUTIVES, MANAGERS, CUSTOMERS, INDIVIDUAL
  targetFilter     Json?             // Optional segment filter
  dataPayload      Json?             // Custom key-value pairs
  imageUrl         String?
  priority         String            @default("NORMAL") // NORMAL, HIGH, URGENT
  status           String            @default("SENT")   // DRAFT, SCHEDULED, SENDING, SENT, FAILED, CANCELLED
  scheduledAt      DateTime?
  sentAt           DateTime?
  totalRecipients  Int               @default(0)
  successCount     Int               @default(0)
  failureCount     Int               @default(0)
  createdById      String
  createdBy        User              @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  recipients       NotificationRecipientLog[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ─── Individual Recipient Delivery Log ─────────────────────────────────────────
model NotificationRecipientLog {
  id               String              @id @default(uuid())
  notificationId   String
  notification     NotificationRecord  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceTokenId    String?
  deviceToken      DevicePushToken?    @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  channel          String              // PUSH, IN_APP, EMAIL, WHATSAPP, SMS
  status           String              @default("PENDING") // PENDING, DELIVERED, READ, FAILED
  errorMessage     String?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime            @default(now())

  @@index([notificationId, status])
  @@index([userId, status])
}

// ─── Notification Templates ───────────────────────────────────────────────────
model NotificationTemplate {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code             String            // e.g. LEAD_ASSIGNED, VISIT_REMINDER, PAYMENT_COLLECTED
  name             String
  category         String            // Operations, Sales, Billing, Security
  subject          String
  body             String
  channels         String[]          // PUSH, IN_APP, EMAIL, WHATSAPP, SMS
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, category])
}

// ─── Territory Management ───────────────────────────────────────────────────
model Territory {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code                  String
  name                  String
  regionArea            String?
  city                  String?
  country               String?           @default("India")
  state                 String?           @default("Maharashtra")
  zone                  String?
  area                  String?
  pincode               String?
  microTerritory        String?
  description           String?
  color                 String            @default("#2563EB")
  status                CrmRecordStatus   @default(ACTIVE)

  managerMembershipId   String?
  managerMembership     TenantMembership? @relation("TerritoryManager", fields: [managerMembershipId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)

  areaKm2               Decimal?          @db.Decimal(10, 2)
  perimeterKm           Decimal?          @db.Decimal(10, 2)
  estBusinesses         Int?              @default(0)
  estPopulation         String?

  revision              Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  createdByMembershipId String
  createdByMembership   TenantMembership  @relation("TerritoryCreator", fields: [createdByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  updatedByMembershipId String
  updatedByMembership   TenantMembership  @relation("TerritoryUpdater", fields: [updatedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  members               TerritoryMember[]
  boundaryPoints        TerritoryBoundaryPoint[]
  targets               TerritoryTarget[]
  accounts              Account[]
  leads                 Lead[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt, createdAt, id])
  @@index([tenantId, managerMembershipId, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, city, deletedAt])
}

model TerritoryMember {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  territoryId           String
  territory             Territory         @relation(fields: [territoryId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)
  membershipId          String
  membership            TenantMembership  @relation("TerritoryMemberMembership", fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  role                  String            @default("FIELD_EXECUTIVE")
  assignedAt            DateTime          @default(now())
  assignedByMembershipId String
  assignedByMembership  TenantMembership  @relation("TerritoryMemberAssigner", fields: [assignedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  @@unique([territoryId, membershipId])
  @@index([tenantId, territoryId])
  @@index([tenantId, membershipId])
}

model TerritoryBoundaryPoint {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  territoryId           String
  territory             Territory         @relation(fields: [territoryId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)
  sequence              Int
  latitude              Float
  longitude             Float

  @@unique([territoryId, sequence])
  @@index([tenantId, territoryId, sequence])
}

model TerritoryTarget {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  territoryId           String
  territory             Territory         @relation(fields: [territoryId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)
  period                String
  monthlyTarget         Decimal           @default(0) @db.Decimal(14, 2)
  monthlyAchieved       Decimal           @default(0) @db.Decimal(14, 2)
  visitTarget           Int               @default(0)
  visitAchieved         Int               @default(0)
  newBusinessTarget     Int               @default(0)
  newBusinessAchieved   Int               @default(0)
  collectionTarget      Decimal           @default(0) @db.Decimal(14, 2)
  collectionAchieved    Decimal           @default(0) @db.Decimal(14, 2)
  revision              Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([territoryId, period])
  @@index([tenantId, territoryId, period])
}

// ─── Lead Sub-Resources (Visits, Follow-ups, Demos, Communications) ────────────

model LeadVisit {
  id                    String            @id @default(uuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                String
  lead                  Lead              @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  executiveMembershipId String
  executiveMembership   TenantMembership  @relation(fields: [executiveMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  executiveName         String
  executiveAvatar       String?
  checkInTime           DateTime          @default(now())
  checkOutTime          DateTime?
  durationMinutes       Int               @default(30)
  location              String
  latitude              Float?
  longitude             Float?
  purpose               String
  outcome               String?
  photos                String[]
  status                String            @default("COMPLETED") // COMPLETED, SCHEDULED, CANCELLED
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([tenantId, leadId, createdAt])
}

model LeadFollowUp {
  id                   String            @id @default(uuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId               String
  lead                 Lead              @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  assignedMembershipId String
  assignedMembership   TenantMembership  @relation(fields: [assignedMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedToName       String
  title                String
  scheduledDate        String // e.g. "2026-09-25"
  scheduledTime        String // e.g. "11:30 AM"
  notes                String?
  status               String            @default("Pending") // Pending, Completed, Cancelled
  completedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([tenantId, leadId, status])
}

model LeadDemo {
  id                      String            @id @default(uuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId                  String
  lead                    Lead              @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  conductedByMembershipId String
  conductedByMembership   TenantMembership  @relation(fields: [conductedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  conductedByName         String
  conductedByAvatar       String?
  demoTitle               String
  demoDate                String // e.g. "2026-09-22"
  demoMode                String            @default("Virtual Google Meet") // Virtual, In-Person
  attendeesCount          Int               @default(3)
  feedbackRating          Float             @default(5.0)
  keyQuestions            String?
  status                  String            @default("COMPLETED") // COMPLETED, SCHEDULED
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([tenantId, leadId, createdAt])
}

model LeadCommunication {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId              String
  lead                Lead              @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  loggedByMembershipId String
  loggedByMembership  TenantMembership  @relation(fields: [loggedByMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  loggedByName        String
  loggedByAvatar      String?
  channel             String            // Call, Email, WhatsApp
  direction           String            @default("Outbound") // Inbound, Outbound
  subject             String
  details             String?
  timestamp           DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@index([tenantId, leadId, timestamp])
}



