generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles ──────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  TEAM_LEADER
  FINANCE_OPS
  SUPPORT

  PLATFORM_SUPER_ADMIN
  PLATFORM_OPERATIONS_ADMIN
  PLATFORM_ONBOARDING
  PLATFORM_SUPPORT
  PLATFORM_BILLING
  PLATFORM_AUDITOR
}

enum DataScope {
  ALL
  ASSIGNED_CITY
  ASSIGNED_TEAM
  SELF_AND_ASSIGNED_LEADS
}

// ─── Users ──────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  employeeCode       String    @unique
  fullName           String
  email              String    @unique
  mobile             String?
  passwordHash       String
  avatarUrl          String?
  role               Role
  dataScope          DataScope @default(ALL)
  teamId             String?
  team               Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managerId          String?
  manager            User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       User[]    @relation("UserManager")
  defaultTerritoryId String?
  status             String    @default("ACTIVE")
  preferredLanguage  String    @default("en")
  twoFactorEnabled   Boolean   @default(false)

  lastLoginAt            DateTime?
  lastPasswordChangeAt   DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  joinedAt               DateTime  @default(now())

  sessions                    UserSession[]
  otpChallenges               OtpChallenge[]
  auditLogs                   AuditLog[]
  modulePermissions           UserModulePermission[] @relation("UserModulePermissions")
  permissionUpdates           UserModulePermission[] @relation("UserModulePermissionUpdater")
  twoFactorRoleSettingUpdates RoleTwoFactorSetting[] @relation("RoleTwoFactorSettingUpdater")

  userShifts      UserShift[]
  attendances     Attendance[]
  punchLogs       PunchLog[]
  salaryStructure SalaryStructure?
  payslips        Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([teamId])
}

// ─── Teams ──────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  members     User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── RBAC ───────────────────────────────────────────────────────────────────────

model Permission {
  id          String  @id @default(uuid())
  moduleKey   String
  action      String // view, create, update, delete
  description String?

  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())

  @@unique([moduleKey, action])
  @@index([moduleKey])
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserModulePermission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserModulePermissions", fields: [userId], references: [id], onDelete: Cascade)
  moduleKey   String
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("UserModulePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
}

model RoleTwoFactorSetting {
  id          String   @id @default(uuid())
  role        Role     @unique
  enabled     Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("RoleTwoFactorSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Sessions / Devices ─────────────────────────────────────────────────────────

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  platform         String?
  ip               String?
  userAgent        String?
  location         String?
  status           String   @default("ACTIVE") // ACTIVE, REVOKED
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, refreshTokenHash])
}

// ─── OTP Challenges ─────────────────────────────────────────────────────────────

model OtpChallenge {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeToken String    @unique
  codeHash       String
  channel        String // EMAIL, SMS
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  consumedAt     DateTime?
  requestIp      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([challengeToken])
  @@index([expiresAt])
}

// ─── Audit Logs ─────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  userAgent   String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Shift & Schedule Management ────────────────────────────────────────────────

model Shift {
  id                    String       @id @default(uuid())
  name                  String // e.g. General Shift, Morning Shift, Night Shift
  code                  String       @unique
  startTime             String // "09:00"
  endTime               String // "18:00"
  gracePeriodMinutes    Int          @default(15)
  halfDayThresholdHours Float        @default(4.5)
  breakDurationMinutes  Int          @default(60)
  isActive              Boolean      @default(true)
  userShifts            UserShift[]
  attendances           Attendance[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model UserShift {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([shiftId])
}

// ─── Attendance & Mobile GPS Punch Logs ───────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum PunchType {
  PUNCH_IN
  PUNCH_OUT
}

model Attendance {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date
  shiftId          String?
  shift            Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  status           AttendanceStatus @default(PRESENT)
  punchInTime      DateTime?
  punchOutTime     DateTime?
  totalWorkMinutes Int              @default(0)
  overtimeMinutes  Int              @default(0)
  lateMinutes      Int              @default(0)
  remarks          String?
  punchLogs        PunchLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model PunchLog {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceId String?
  attendance   Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  type         PunchType
  timestamp    DateTime    @default(now())
  latitude     Float
  longitude    Float
  locationName String?
  photoUrl     String?
  deviceId     String?
  deviceModel  String?
  ipAddress    String?

  @@index([userId])
  @@index([attendanceId])
  @@index([timestamp])
}

// ─── Payroll & Payslips ─────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model SalaryStructure {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary   Float
  hra          Float    @default(0)
  conveyance   Float    @default(0)
  allowances   Float    @default(0)
  pfDeduction  Float    @default(0)
  esiDeduction Float    @default(0)
  tds          Float    @default(0)
  netSalary    Float
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PayrollPeriod {
  id          String        @id @default(uuid())
  month       Int // 1 - 12
  year        Int // e.g. 2025
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([month, year])
}

model Payslip {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  baseSalary      Float
  totalAllowances Float         @default(0)
  totalDeductions Float         @default(0)
  netPay          Float
  presentDays     Int           @default(0)
  absentDays      Int           @default(0)
  lateDays        Int           @default(0)
  overtimeHours   Float         @default(0)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentDate     DateTime?
  transactionRef  String?
  downloadUrl     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, payrollPeriodId])
  @@index([userId])
  @@index([payrollPeriodId])
  @@index([paymentStatus])
}

// ─── Master Data Management ───────────────────────────────────────────────────

model MasterRecord {
  id              String   @id @default(uuid())
  category        String // designation, team, incentive_type, allowance_type, deduction_type, shift, territory, expense_category, lead_stage, lead_source
  name            String
  code            String
  description     String?
  displayColor    String? // hex code or tailwind color class
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
  @@index([category, isActive])
}

// ─── Platform Modules & Features System ───────────────────────────────────────

enum PlatformModuleCategory {
  CORE
  SALES
  FIELD_OPS
  AUTOMATION
  ENTERPRISE
}

enum PlatformModuleStatus {
  DRAFT
  ACTIVE
  BETA
  DEPRECATED
  ARCHIVED
}

enum ModuleFeatureStatus {
  ACTIVE
  BETA
  DEPRECATED
}

model PlatformModule {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  description String
  category    PlatformModuleCategory @default(CORE)
  status      PlatformModuleStatus   @default(ACTIVE)

  requiredBySystem Boolean @default(false)
  displayOrder     Int     @default(0)
  internalNotes    String?

  features ModuleFeature[]

  dependencies ModuleDependency[] @relation("ModuleDependencies")
  dependents   ModuleDependency[] @relation("ModuleDependents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([displayOrder])
}

model ModuleFeature {
  id                String              @id @default(uuid())
  moduleId          String
  module            PlatformModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String
  status            ModuleFeatureStatus @default(ACTIVE)
  implementationKey String              @unique
  supportsWeb       Boolean             @default(false)
  supportsMobile    Boolean             @default(false)
  supportsApi       Boolean             @default(false)
  supportsOffline   Boolean             @default(false)
  displayOrder      Int                 @default(0)
  internalNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, code])
  @@index([moduleId])
  @@index([status])
}

model ModuleDependency {
  id                String         @id @default(uuid())
  moduleId          String
  module            PlatformModule @relation("ModuleDependencies", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOnModuleId String
  dependsOnModule   PlatformModule @relation("ModuleDependents", fields: [dependsOnModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([moduleId, dependsOnModuleId])
  @@index([moduleId])
  @@index([dependsOnModuleId])
}
