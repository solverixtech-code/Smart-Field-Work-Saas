generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Roles ──────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  TEAM_LEADER
  FINANCE_OPS
  SUPPORT

  PLATFORM_SUPER_ADMIN
  PLATFORM_OPERATIONS_ADMIN
  PLATFORM_ONBOARDING
  PLATFORM_SUPPORT
  PLATFORM_BILLING
  PLATFORM_AUDITOR
}

enum DataScope {
  ALL
  ASSIGNED_CITY
  ASSIGNED_TEAM
  SELF_AND_ASSIGNED_LEADS
}

// ─── Users ──────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  employeeCode       String    @unique
  fullName           String
  email              String    @unique
  mobile             String?
  passwordHash       String
  avatarUrl          String?
  role               Role
  dataScope          DataScope @default(ALL)
  teamId             String?
  team               Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  managerId          String?
  manager            User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates       User[]    @relation("UserManager")
  defaultTerritoryId String?
  status             String    @default("ACTIVE")
  preferredLanguage  String    @default("en")
  twoFactorEnabled   Boolean   @default(false)

  lastLoginAt            DateTime?
  lastPasswordChangeAt   DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  joinedAt               DateTime  @default(now())

  sessions                    UserSession[]
  otpChallenges               OtpChallenge[]
  auditLogs                   AuditLog[]
  modulePermissions           UserModulePermission[] @relation("UserModulePermissions")
  permissionUpdates           UserModulePermission[] @relation("UserModulePermissionUpdater")
  twoFactorRoleSettingUpdates RoleTwoFactorSetting[] @relation("RoleTwoFactorSettingUpdater")

  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  tenantMemberships        TenantMembership[]
  membershipInvitesCreated TenantMembership[]           @relation("MembershipInvitedBy")
  platformRoleAssignments  PlatformUserRoleAssignment[] @relation("UserPlatformRoleAssignments")
  platformRolesAssigned    PlatformUserRoleAssignment[] @relation("PlatformRoleAssignedBy")
  publishedPlanVersions    PlanVersion[]                @relation("PlanVersionPublishedBy")
  subscriptionChanges     SubscriptionChange[]         @relation("SubscriptionChangeActor")
  provisionedTenants       TenantProvisioning[]         @relation("TenantProvisioningActor")
  provisioningAttempts    ProvisioningAttempt[]         @relation("ProvisioningAttemptActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([teamId])
}

// ─── Teams ──────────────────────────────────────────────────────────────────────

model Team {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  description       String?
  isActive          Boolean            @default(true)
  tenantId          String?
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  members           User[]
  tenantMemberships TenantMembership[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

enum PermissionScope {
  PLATFORM
  TENANT
}

// ─── RBAC ───────────────────────────────────────────────────────────────────────

model Permission {
  id              String           @id @default(uuid())
  code            String?          @unique
  scope           PermissionScope?
  domain          String?
  resource        String?
  moduleKey       String
  action          String // view, create, update, delete
  description     String?
  isActive        Boolean          @default(true)
  registryVersion String?

  rolePermissions         RolePermission[]
  tenantRolePermissions   TenantRolePermission[]
  platformRolePermissions PlatformRolePermission[]
  createdAt               DateTime                 @default(now())

  @@unique([moduleKey, action])
  @@index([moduleKey])
  @@index([scope])
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserModulePermission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserModulePermissions", fields: [userId], references: [id], onDelete: Cascade)
  moduleKey   String
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canUpdate   Boolean  @default(false)
  canDelete   Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("UserModulePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleKey])
  @@index([userId])
}

model RoleTwoFactorSetting {
  id          String   @id @default(uuid())
  role        Role     @unique
  enabled     Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation("RoleTwoFactorSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Sessions / Devices ─────────────────────────────────────────────────────────

model UserSession {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash     String
  platform             String?
  ip                   String?
  userAgent            String?
  location             String?
  status               String            @default("ACTIVE") // ACTIVE, REVOKED
  selectedMembershipId String?
  selectedMembership   TenantMembership? @relation(fields: [selectedMembershipId], references: [id], onDelete: SetNull)
  contextVersion       Int               @default(1)
  selectedMembershipAt DateTime?
  lastSeenAt           DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId, status])
  @@index([userId, refreshTokenHash])
  @@index([selectedMembershipId])
}

// ─── OTP Challenges ─────────────────────────────────────────────────────────────

model OtpChallenge {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeToken String    @unique
  codeHash       String
  channel        String // EMAIL, SMS
  expiresAt      DateTime
  attemptCount   Int       @default(0)
  consumedAt     DateTime?
  requestIp      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([challengeToken])
  @@index([expiresAt])
}

// ─── Audit Logs ─────────────────────────────────────────────────────────────────

model AuditLog {
  id                 String            @id @default(uuid())
  actorUserId        String?
  actorUser          User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  action             String
  entityType         String?
  entityId           String?
  beforeJson         Json?
  afterJson          Json?
  ip                 String?
  userAgent          String?
  sessionId          String?
  createdAt          DateTime          @default(now())

  @@index([actorUserId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Shift & Schedule Management ────────────────────────────────────────────────

model Shift {
  id                    String       @id @default(uuid())
  tenantId              String?
  tenant                Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name                  String // e.g. General Shift, Morning Shift, Night Shift
  code                  String
  startTime             String // "09:00"
  endTime               String // "18:00"
  gracePeriodMinutes    Int          @default(15)
  halfDayThresholdHours Float        @default(4.5)
  breakDurationMinutes  Int          @default(60)
  isActive              Boolean      @default(true)
  userShifts            UserShift[]
  attendances           Attendance[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model UserShift {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId            String
  shift              Shift             @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime?
  createdAt          DateTime          @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([shiftId])
}

// ─── Attendance & Mobile GPS Punch Logs ───────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum PunchType {
  PUNCH_IN
  PUNCH_OUT
}

model Attendance {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime          @db.Date
  shiftId            String?
  shift              Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  status             AttendanceStatus  @default(PRESENT)
  punchInTime        DateTime?
  punchOutTime       DateTime?
  totalWorkMinutes   Int               @default(0)
  overtimeMinutes    Int               @default(0)
  lateMinutes        Int               @default(0)
  remarks            String?
  punchLogs          PunchLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, tenantMembershipId, date])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([date])
  @@index([status])
}

model PunchLog {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceId       String?
  attendance         Attendance?       @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  type               PunchType
  timestamp          DateTime          @default(now())
  latitude           Float
  longitude          Float
  locationName       String?
  photoUrl           String?
  deviceId           String?
  deviceModel        String?
  ipAddress          String?

  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([attendanceId])
  @@index([timestamp])
}

// ─── Payroll & Payslips ─────────────────────────────────────────────────────────

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model SalaryStructure {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseSalary         Float
  hra                Float             @default(0)
  conveyance         Float             @default(0)
  allowances         Float             @default(0)
  pfDeduction        Float             @default(0)
  esiDeduction       Float             @default(0)
  tds                Float             @default(0)
  netSalary          Float
  currency           String            @default("INR")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantId, tenantMembershipId])
  @@index([tenantId])
  @@index([tenantMembershipId])
}

model PayrollPeriod {
  id          String        @id @default(uuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  month       Int // 1 - 12
  year        Int // e.g. 2025
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  paidAt      DateTime?
  payslips    Payslip[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model Payslip {
  id                 String            @id @default(uuid())
  tenantId           String?
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?
  tenantMembership   TenantMembership? @relation(fields: [tenantMembershipId], references: [id], onDelete: SetNull)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrollPeriodId    String
  payrollPeriod      PayrollPeriod     @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  baseSalary         Float
  totalAllowances    Float             @default(0)
  totalDeductions    Float             @default(0)
  netPay             Float
  presentDays        Int               @default(0)
  absentDays         Int               @default(0)
  lateDays           Int               @default(0)
  overtimeHours      Float             @default(0)
  paymentStatus      PaymentStatus     @default(PENDING)
  paymentDate        DateTime?
  transactionRef     String?
  downloadUrl        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([tenantMembershipId, payrollPeriodId])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantMembershipId])
  @@index([payrollPeriodId])
  @@index([paymentStatus])
}

// ─── Master Data Management ───────────────────────────────────────────────────

model MasterRecord {
  id              String   @id @default(uuid())
  category        String // designation, team, incentive_type, allowance_type, deduction_type, shift, territory, expense_category, lead_stage, lead_source
  name            String
  code            String
  description     String?
  displayColor    String? // hex code or tailwind color class
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
  @@index([category, isActive])
}

// ─── Platform Modules & Features System ───────────────────────────────────────

enum PlatformModuleCategory {
  CORE
  SALES
  FIELD_OPS
  AUTOMATION
  ENTERPRISE
}

enum PlatformModuleStatus {
  DRAFT
  ACTIVE
  BETA
  DEPRECATED
  ARCHIVED
}

enum ModuleFeatureStatus {
  ACTIVE
  BETA
  DEPRECATED
}

model PlatformModule {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  description String
  category    PlatformModuleCategory @default(CORE)
  status      PlatformModuleStatus   @default(ACTIVE)

  requiredBySystem Boolean @default(false)
  displayOrder     Int     @default(0)
  internalNotes    String?

  features ModuleFeature[]

  dependencies ModuleDependency[] @relation("ModuleDependencies")
  dependents   ModuleDependency[] @relation("ModuleDependents")
  planModules  PlanModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([displayOrder])
}

model ModuleFeature {
  id                String              @id @default(uuid())
  moduleId          String
  module            PlatformModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String
  status            ModuleFeatureStatus @default(ACTIVE)
  implementationKey String              @unique
  supportsWeb       Boolean             @default(false)
  supportsMobile    Boolean             @default(false)
  supportsApi       Boolean             @default(false)
  supportsOffline   Boolean             @default(false)
  displayOrder      Int                 @default(0)
  internalNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, code])
  @@index([moduleId])
  @@index([status])
}

model ModuleDependency {
  id                String         @id @default(uuid())
  moduleId          String
  module            PlatformModule @relation("ModuleDependencies", fields: [moduleId], references: [id], onDelete: Cascade)
  dependsOnModuleId String
  dependsOnModule   PlatformModule @relation("ModuleDependents", fields: [dependsOnModuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([moduleId, dependsOnModuleId])
  @@index([moduleId])
  @@index([dependsOnModuleId])
}

// ─── Phase 0.2 — Tenant & Membership Models ────────────────────────────────────

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum TenantAddressType {
  REGISTERED
  BILLING
  OFFICE
}

enum TenantMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum PlatformAssignmentStatus {
  ACTIVE
  REVOKED
  SUSPENDED
}

model Tenant {
  industryCode    String?
  industry        IndustryClassification? @relation(fields: [industryCode], references: [code], onDelete: Restrict)
  subscription    TenantSubscription?
  provisioning    TenantProvisioning?
  id              String                  @id @default(uuid())
  slug            String                  @unique
  displayName     String
  legalName       String?
  primaryDomain   String?                 @unique
  websiteUrl      String?
  status          TenantStatus            @default(DRAFT)
  companySizeCode String?
  description     String?

  activatedAt DateTime?
  suspendedAt DateTime?
  cancelledAt DateTime?
  archivedAt  DateTime?

  addresses        TenantAddress[]
  settings         TenantSettings?
  branding         TenantBranding?
  memberships      TenantMembership[]
  roles            TenantRole[]
  teams            Team[]
  shifts           Shift[]
  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payrollPeriods   PayrollPeriod[]
  payslips         Payslip[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model TenantAddress {
  id            String            @id @default(uuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          TenantAddressType @default(REGISTERED)
  label         String?
  line1         String
  line2         String?
  city          String
  stateOrRegion String?
  postalCode    String?
  countryCode   String            @default("IN")
  isPrimary     Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenantSettings {
  id                      String @id @default(uuid())
  tenantId                String @unique
  tenant                  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone                String @default("Asia/Kolkata")
  currency                String @default("INR")
  locale                  String @default("en-IN")
  language                String @default("en")
  dateFormat              String @default("YYYY-MM-DD")
  weekStartDay            String @default("MONDAY")
  financialYearStartMonth Int    @default(4)
  configVersion           Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantBranding {
  id              String  @id @default(uuid())
  tenantId        String  @unique
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shortName       String?
  primaryColor    String? @default("#0D1F3D")
  secondaryColor  String?
  logoUrl         String?
  showLogoOnLogin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantMembership {
  provisioningOwnership TenantProvisioning[]
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantRoleId          String?
  tenantRole            TenantRole?            @relation(fields: [tenantRoleId], references: [id], onDelete: SetNull)
  status                TenantMembershipStatus @default(ACTIVE)
  isPrimary             Boolean                @default(false)

  employeeCode String?
  designation  String?
  department   String?
  dataScope    DataScope? @default(ALL)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  managerMembershipId    String?
  managerMembership      TenantMembership?  @relation("MembershipManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  subordinateMemberships TenantMembership[] @relation("MembershipManager")

  invitedByUserId String?
  invitedByUser   User?   @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  invitedAt     DateTime?
  joinedAt      DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?

  selectedSessions UserSession[]
  userShifts       UserShift[]
  attendances      Attendance[]
  punchLogs        PunchLog[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@index([userId, status])
  @@index([tenantRoleId])
  @@index([managerMembershipId])
}

model TenantRoleTemplate {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(true)
  isActive    Boolean @default(true)

  roles TenantRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantRole {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId         String?
  template           TenantRoleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  code               String
  name               String
  description        String?
  isSystem           Boolean             @default(true)
  isActive           Boolean             @default(true)
  permissionsVersion Int                 @default(1)

  memberships TenantMembership[]
  permissions TenantRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model TenantRolePermission {
  id           String     @id @default(uuid())
  tenantRoleId String
  tenantRole   TenantRole @relation(fields: [tenantRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantRoleId, permissionId])
  @@index([tenantRoleId])
}

model PlatformRole {
  id                 String  @id @default(uuid())
  code               String  @unique
  name               String
  description        String?
  isSystem           Boolean @default(true)
  isActive           Boolean @default(true)
  permissionsVersion Int     @default(1)

  assignments PlatformUserRoleAssignment[]
  permissions PlatformRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformRolePermission {
  id             String       @id @default(uuid())
  platformRoleId String
  platformRole   PlatformRole @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([platformRoleId, permissionId])
  @@index([platformRoleId])
}

model PlatformUserRoleAssignment {
  id               String                   @id @default(uuid())
  userId           String
  user             User                     @relation("UserPlatformRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  platformRoleId   String
  platformRole     PlatformRole             @relation(fields: [platformRoleId], references: [id], onDelete: Cascade)
  status           PlatformAssignmentStatus @default(ACTIVE)
  validFrom        DateTime?
  validUntil       DateTime?
  assignedByUserId String?
  assignedByUser   User?                    @relation("PlatformRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platformRoleId])
  @@index([userId, status])
  @@index([platformRoleId])
}

// ─── Phase 0.5 — Plan & PlanVersion Commercial Engine ──────────────────────────

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanVisibility {
  PUBLIC
  INTERNAL
  INVITE_ONLY
}

enum PlanVersionStatus {
  DRAFT
  PUBLISHED
}

enum PricingModel {
  PER_USER
  BASE_PLUS_PER_USER
  FLAT
  CUSTOM_CONTRACT
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
}

enum ProrationPolicy {
  NONE
  IMMEDIATE
  NEXT_BILLING_CYCLE
}

enum ExpiryAccess {
  READ_ONLY
  BLOCKED
}

enum ChangeEffectiveTiming {
  IMMEDIATE
  NEXT_BILLING_CYCLE
}

enum LimitValueType {
  INTEGER
  DECIMAL
  BOOLEAN
}

model Plan {
  id                        String         @id @default(uuid())
  code                      String         @unique
  name                      String
  description               String
  internalDescription       String?
  status                    PlanStatus     @default(DRAFT)
  visibility                PlanVisibility @default(PUBLIC)
  tier                      String?
  badge                     String?
  recommendedFor            String?
  displayOrder              Int            @default(0)
  color                     String?
  currentPublishedVersionId String?
  currentPublishedVersion   PlanVersion?   @relation("CurrentPublishedPlanVersion", fields: [currentPublishedVersionId], references: [id], onDelete: SetNull)

  versions PlanVersion[] @relation("PlanVersions")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  @@index([status])
  @@index([visibility])
  @@index([displayOrder])
}

model PlanVersion {
  subscriptions     TenantSubscription[]
  changesFrom       SubscriptionChange[] @relation("SubscriptionChangeFrom")
  changesTo         SubscriptionChange[] @relation("SubscriptionChangeTo")
  id                String               @id @default(uuid())
  planId            String
  plan              Plan                 @relation("PlanVersions", fields: [planId], references: [id], onDelete: Restrict)
  version           Int
  status            PlanVersionStatus    @default(DRAFT)
  publishedAt       DateTime?
  publishedByUserId String?
  publishedByUser   User?                @relation("PlanVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  currentPublishedForPlans Plan[] @relation("CurrentPublishedPlanVersion")

  pricing        PlanPricing[]
  limits         PlanLimit[]
  modules        PlanModule[]
  commercialRule PlanCommercialRule?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, version])
  @@index([planId, status])
  @@index([status])
}

model PlanPricing {
  id                      String          @id @default(uuid())
  planVersionId           String
  planVersion             PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  model                   PricingModel    @default(PER_USER)
  billingCycle            BillingCycle
  currency                String          @default("INR")
  baseFee                 Decimal?        @db.Decimal(18, 2)
  perSeatFee              Decimal?        @db.Decimal(18, 2)
  flatFee                 Decimal?        @db.Decimal(18, 2)
  setupFee                Decimal?        @db.Decimal(18, 2)
  minimumCommitmentAmount Decimal?        @db.Decimal(18, 2)
  discountPercent         Decimal?        @db.Decimal(5, 2)
  taxMode                 TaxMode         @default(EXCLUSIVE)
  prorationPolicy         ProrationPolicy @default(NONE)

  createdAt DateTime @default(now())

  @@unique([planVersionId, billingCycle])
  @@index([planVersionId])
}

model PlanLimit {
  id            String         @id @default(uuid())
  planVersionId String
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  limitCode     String
  valueType     LimitValueType
  integerValue  Int?
  decimalValue  Decimal?       @db.Decimal(18, 2)
  booleanValue  Boolean?
  isUnlimited   Boolean        @default(false)
  unit          String?

  createdAt DateTime @default(now())

  @@unique([planVersionId, limitCode])
  @@index([planVersionId])
  @@index([limitCode])
}

model PlanModule {
  id            String         @id @default(uuid())
  planVersionId String
  planVersion   PlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  moduleId      String
  module        PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([planVersionId, moduleId])
  @@index([planVersionId])
  @@index([moduleId])
}

model PlanCommercialRule {
  id            String      @id @default(uuid())
  planVersionId String      @unique
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  schemaVersion Int         @default(1)
  rules         Json

  createdAt DateTime @default(now())

  @@index([planVersionId])
}

// Phase 0.6: classification only; never an entitlement or Industry template.
model IndustryClassification {
  code     String   @id
  name     String
  isActive Boolean  @default(true)
  tenants  Tenant[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

enum SubscriptionChangeStatus {
  SCHEDULED
  APPLIED
  CANCELLED
}

enum ProvisioningEventStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
}

model TenantSubscription {
  id                 String               @id @default(uuid())
  tenantId           String               @unique
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planVersionId      String
  planVersion        PlanVersion          @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  billingCycle       BillingCycle
  seatQuantity       Int
  status             SubscriptionStatus
  revision           Int                  @default(1)
  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  graceEndsAt        DateTime?
  cancelledAt        DateTime?
  suspendedFromStatus SubscriptionStatus?
  changes            SubscriptionChange[]
  provisioning       TenantProvisioning?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([id, tenantId])
}

model SubscriptionChange {
  id                String                   @id @default(uuid())
  subscriptionId    String
  tenantId          String
  subscription      TenantSubscription       @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  idempotencyKey    String
  payloadHash       String
  kind              String
  reason            String
  fromPlanVersionId String
  fromPlanVersion   PlanVersion              @relation("SubscriptionChangeFrom", fields: [fromPlanVersionId], references: [id], onDelete: Restrict)
  toPlanVersionId   String
  toPlanVersion     PlanVersion              @relation("SubscriptionChangeTo", fields: [toPlanVersionId], references: [id], onDelete: Restrict)
  fromStatus        SubscriptionStatus
  toStatus          SubscriptionStatus
  status            SubscriptionChangeStatus
  requestedAt       DateTime                 @default(now())
  effectiveAt       DateTime
  appliedAt         DateTime?
  actorUserId       String
  actor             User                     @relation("SubscriptionChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "SubscriptionChange_actor_fkey")
  requestId         String?
  revision          Int
  requestData       Json
  result            Json

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId, requestedAt])
  @@index([status, effectiveAt])
}

model TenantProvisioning {
  id                String              @id @default(uuid())
  idempotencyKey    String              @unique
  payloadHash       String
  tenantId          String              @unique
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId    String              @unique
  subscription      TenantSubscription  @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ownerMembershipId String
  ownerMembership   TenantMembership    @relation(fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorUserId       String
  actor             User                @relation("TenantProvisioningActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "TenantProvisioning_actor_fkey")
  requestId         String?
  acceptedAt        DateTime?
  createdAt         DateTime            @default(now())
  events            ProvisioningEvent[]

  @@unique([subscriptionId, tenantId])
}

model ProvisioningEvent {
  id             String                  @id @default(uuid())
  provisioningId String
  provisioning   TenantProvisioning      @relation(fields: [provisioningId], references: [id], onDelete: Restrict)
  kind           String
  schemaVersion  Int                     @default(1)
  status         ProvisioningEventStatus @default(PENDING)
  attemptCount   Int                     @default(0)
  leaseToken     String?
  leaseEndsAt    DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  attempts       ProvisioningAttempt[]

  @@unique([provisioningId, kind])
  @@index([status, createdAt])
}

model ProvisioningAttempt {
  id          String                  @id @default(uuid())
  eventId     String
  event       ProvisioningEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attemptKey  String
  leaseToken  String                  @unique
  actorUserId String
  actor       User                    @relation("ProvisioningAttemptActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "ProvisioningAttempt_actor_fkey")
  status      ProvisioningEventStatus @default(PROCESSING)
  errorCode   String?
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?

  @@unique([eventId, attemptKey])
}
