{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist && prisma generate --schema=prisma/schema.prisma",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main",
    "worker:jobs": "node dist/worker.js",
    "worker:jobs:dev": "ts-node src/worker.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "db:seed": "ts-node prisma/seed-dev.ts",
    "db:seed:dev": "ts-node prisma/seed-dev.ts",
    "db:seed:production": "ts-node prisma/seed.ts",
    "seed": "ts-node prisma/seed-dev.ts",
    "db:backfill:platform-roles": "ts-node prisma/backfills/backfill-platform-roles.ts",
    "db:report:tenant-ownership": "ts-node prisma/backfills/reconcile-tenant-ownership.ts",
    "db:sync:rbac": "ts-node prisma/sync-rbac.ts",
    "db:sync:field-dashboard": "ts-node -r dotenv/config prisma/sync-field-dashboard-permission.ts",
    "db:sync:field-executive": "ts-node -r dotenv/config prisma/sync-field-dashboard-permission.ts",
    "db:sync:follow-up-management": "ts-node -r dotenv/config prisma/sync-follow-up-management-permission.ts",
    "db:reconcile:subscriptions": "ts-node prisma/backfills/reconcile-subscriptions.ts",
    "db:reconcile:industries": "ts-node prisma/backfills/reconcile-industries.ts",
    "db:reconcile:masters": "ts-node prisma/backfills/reconcile-masters.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.1.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.1.0",
    "@visiblo/shared": "*",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^14.4.0",
    "ioredis": "^5.4.1",
    "joi": "^17.9.2",
    "nodemailer": "^9.0.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.1",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.1.11",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.1.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.4.5",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "prettier": "^3.0.0",
    "prisma": "^5.1.0",
    "run-script-webpack-plugin": "^0.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@visiblo/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^(\\.\\.?/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
