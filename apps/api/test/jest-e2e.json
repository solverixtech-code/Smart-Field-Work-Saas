{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@visiblo/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
    "^(\\.\\.?/.*)\\.js$": "$1"
  }
}
